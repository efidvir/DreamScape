# Copy to .env and adjust. Everything has a working default.

# Port for the dream page on this machine (http://localhost)
WEB_PORT=80

# ---- language model (runs in the ollama container) ----
# gemma3:4b needs about 3.3 GB of video memory and writes good Hebrew and English.
LLM_MODEL=gemma3:4b
# To use an Ollama you already run on Windows instead of the container:
# OLLAMA_URL=http://host.docker.internal:11434

# ---- speech to text (faster-whisper) ----
# ivrit.ai's Hebrew fine-tune of Whisper large-v3-turbo, about 1.5 GB of video memory.
STT_MODEL=ivrit-ai/whisper-large-v3-turbo-ct2
# Optional second model for English (loads on first English utterance, +1.5 GB):
# STT_MODEL_EN=large-v3-turbo

# ---- text to speech (BlueTTS, runs on the CPU) ----
# The dreamer starts with a neutral voice (two voices averaged), then takes a gendered one.
VOICE_NEUTRAL=noa,ariel
VOICE_FEMALE=maya
VOICE_MALE=daniel
TTS_SPEED=0.95

# ---- dreamy background images (optional) ----
# Renders on a second GPU machine running worker/docker-compose.yml.
# COMPOSE_PROFILES=imagery
# IMAGERY_URL=http://imagery:9030
# Render on this laptop instead (uses ~3 GB more video memory):
# IMAGERY_LOCAL=1
